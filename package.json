{
  "name": "still-water",
  "version": "1.0.0",
  "private": true,
  "description": "静湖微澜 · Serene Ripple Lake —— Three.js 治愈湖面。双入口：免构建 index.html（file:// 双击即开）+ Vite 构建版 dist/",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "assert": "node plan/wp5-assert.js",
    "assert:dist": "node plan/wp5-assert.js file:///D:/projects/still_water/dist/index.html?debug=1",
    "assert:shots": "node plan/wp5-assert.js --shots",
    "audio:baseline": "python plan/audio-baseline.py",
    "pw": "playwright test --config=plan/pw/playwright.config.mjs",
    "pw:update": "playwright test --config=plan/pw/playwright.config.mjs --update-snapshots",
    "pw:compare": "node plan/pw/compare-readings.mjs",
    "pw:frozen": "node plan/pw/verify-frozen.mjs",
    "pw:mix": "node plan/pw/verify-mix.mjs",
    "pw:dist": "node plan/pw/verify-dist.mjs check",
    "pw:dist:snapshot": "node plan/pw/verify-dist.mjs snapshot",
    "deploy": "npx --yes netlify-cli deploy --prod --dir=dist"
  },
  "dependencies": {
    "three": "0.160.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
